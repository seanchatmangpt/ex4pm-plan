---
to: "src/ex4pm_plan/generated_contract.py"
sparql:
  contract: |
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX ep: <https://w3id.org/ex4pm/plan#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?protocol ?authority ?actuation ?problem ?worker_solver WHERE {
      ep:Worker dcterms:identifier ?protocol ;
        ep:authority ?authority ;
        ep:actuation ?actuation ;
        ep:problemType ?problem_node ;
        ep:workerSolver ?worker_solver_node .
      ?problem_node skos:notation ?problem .
      ?worker_solver_node skos:notation ?worker_solver .
    }
  library_solvers: |
    PREFIX ep: <https://w3id.org/ex4pm/plan#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?solver WHERE {
      ep:Worker ep:librarySolver ?solver_node .
      ?solver_node skos:notation ?solver .
    }
    ORDER BY ?solver
  operations: |
    PREFIX ep: <https://w3id.org/ex4pm/plan#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?operation WHERE {
      ep:Worker ep:operation ?operation_node .
      ?operation_node skos:notation ?operation .
    }
    ORDER BY ?operation
---
# GENERATED by ggen from ggen/packs/ex4pm-plan-contract-pack/ontology.ttl.
# Do not edit this projection directly.

PROTOCOL = "{{ contract[0].protocol }}"
SUPPORTED_PROBLEM = "{{ contract[0].problem }}"
SUPPORTED_SOLVER = "{{ contract[0].worker_solver }}"
LIBRARY_SOLVERS = (
{% for row in library_solvers %}    "{{ row.solver }}",
{% endfor %})
OPERATIONS = (
{% for row in operations %}    "{{ row.operation }}",
{% endfor %})
AUTHORITY = "{{ contract[0].authority }}"
ACTUATION = {% if contract[0].actuation == "true" %}True{% else %}False{% endif %}
